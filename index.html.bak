<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Propuesta Técnico-Comercial | IntiWatt</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        intiwatt: {
                            orange: '#f59e0b',
                            darkorange: '#d97706',
                            lightorange: '#fef3c7',
                            navy: '#0f172a',
                            slate: '#1e293b',
                            graybg: '#f8fafc'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; }
            .print-shadow-none { box-shadow: none !important; border: 1px solid #e2e8f0 !important; }
            .page-break { page-break-before: always; }
        }
        .gradient-brand {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        }
        .accent-glow {
            box-shadow: 0 0 25px -5px rgba(245, 158, 11, 0.25);
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen py-6 px-3 sm:px-6 lg:px-8">

    <div class="max-w-5xl mx-auto space-y-6">

        <!-- HEADER & BRANDING -->
        <header class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-8 print-shadow-none">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <!-- Logo & Brand Title -->
                <div class="flex items-center gap-4">
                    <!-- IntiWatt Official Sun-Chip Circuit Logo -->
                    <div class="flex-shrink-0">
                        <svg class="w-16 h-16 sm:w-20 sm:h-20" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <!-- Center Microchip -->
                            <rect x="75" y="55" width="50" height="50" rx="8" stroke="#F59E0B" stroke-width="4.5" fill="none"/>
                            <rect x="85" y="65" width="30" height="30" rx="5" stroke="#F59E0B" stroke-width="3.5" fill="none"/>
                            <rect x="92" y="72" width="16" height="16" rx="3" fill="#F59E0B"/>
                            
                            <!-- Chip Pins -->
                            <line x1="83" y1="47" x2="83" y2="55" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="94" y1="47" x2="94" y2="55" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="106" y1="47" x2="106" y2="55" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="117" y1="47" x2="117" y2="55" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="83" y1="105" x2="83" y2="113" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="94" y1="105" x2="94" y2="113" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="106" y1="105" x2="106" y2="113" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="117" y1="105" x2="117" y2="113" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="67" y1="63" x2="75" y2="63" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="67" y1="74" x2="75" y2="74" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="67" y1="86" x2="75" y2="86" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="67" y1="97" x2="75" y2="97" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="125" y1="63" x2="133" y2="63" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="125" y1="74" x2="133" y2="74" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="125" y1="86" x2="133" y2="86" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <line x1="125" y1="97" x2="133" y2="97" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>

                            <!-- Main Circle Ring -->
                            <circle cx="100" cy="80" r="54" stroke="#F59E0B" stroke-width="4.5" fill="none"/>

                            <!-- Radial Circuit Traces -->
                            <path d="M100 26 L100 14" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="100" cy="10" r="4.5" fill="#F59E0B"/>
                            <path d="M100 134 L100 146" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="100" cy="150" r="4.5" fill="#F59E0B"/>
                            <path d="M46 80 L34 80" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="30" cy="80" r="4.5" fill="#F59E0B"/>
                            <path d="M154 80 L166 80" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="170" cy="80" r="4.5" fill="#F59E0B"/>
                            <path d="M121 30 L130 18" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="133" cy="14" r="4.5" fill="#F59E0B"/>
                            <path d="M138 42 L150 32 L158 32" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="163" cy="32" r="4.5" fill="#F59E0B"/>
                            <path d="M149 59 L162 52 L172 52" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="177" cy="52" r="4.5" fill="#F59E0B"/>
                            <path d="M149 101 L162 108 L172 108" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="177" cy="108" r="4.5" fill="#F59E0B"/>
                            <path d="M138 118 L150 128 L158 128" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="163" cy="128" r="4.5" fill="#F59E0B"/>
                            <path d="M121 130 L130 142" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="133" cy="146" r="4.5" fill="#F59E0B"/>
                            <path d="M79 130 L70 142" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="67" cy="146" r="4.5" fill="#F59E0B"/>
                            <path d="M62 118 L50 128 L42 128" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="37" cy="128" r="4.5" fill="#F59E0B"/>
                            <path d="M51 101 L38 108 L28 108" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="23" cy="108" r="4.5" fill="#F59E0B"/>
                            <path d="M51 59 L38 52 L28 52" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="23" cy="52" r="4.5" fill="#F59E0B"/>
                            <path d="M62 42 L50 32 L42 32" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="37" cy="32" r="4.5" fill="#F59E0B"/>
                            <path d="M79 30 L70 18" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                            <circle cx="67" cy="14" r="4.5" fill="#F59E0B"/>
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-amber-500 tracking-tight" style="font-weight: 800;">IntiWatt</h1>
                            <span class="px-2.5 py-0.5 text-xs font-bold bg-amber-100 text-amber-800 rounded-full border border-amber-200">Ingeniería Solar</span>
                        </div>
                        <p class="text-xs sm:text-sm font-semibold text-amber-600 uppercase tracking-wider mt-0.5">Somos la Eficiencia Energética</p>
                    </div>
                </div>

                <!-- Document Meta & Print Action -->
                <div class="flex flex-col sm:flex-row md:flex-col items-start md:items-end justify-between w-full md:w-auto gap-3 pt-4 md:pt-0 border-t md:border-t-0 border-slate-100">
                    <div class="text-left md:text-right text-xs sm:text-sm text-slate-500 space-y-0.5">
                        <p class="font-medium text-slate-700">Fecha: <span class="text-slate-900 font-semibold">Octubre 2026</span></p>
                        <p>Validez: <span class="font-medium text-slate-700">15 días corridos</span></p>
                        <p>Distribuidora: <span class="font-semibold text-slate-800">EDESE S.A.</span></p>
                    </div>
                    <button onclick="window.print()" class="no-print inline-flex items-center gap-2 px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl transition shadow-md hover:shadow-lg">
                        <i class="fa-solid fa-print"></i> Imprimir / Guardar PDF
                    </button>
                </div>
            </div>
        </header>

        <!-- PROPOSAL BANNER & CLIENT DATA -->
        <section class="gradient-brand text-white rounded-2xl shadow-xl p-6 sm:p-8 print-shadow-none relative overflow-hidden">
            <div class="absolute -right-12 -bottom-12 w-64 h-64 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

            <div class="relative z-10 space-y-6">
                <div>
                    <span class="inline-block px-3 py-1 bg-amber-500/20 text-amber-300 text-xs font-bold rounded-lg uppercase tracking-wider border border-amber-500/30 mb-2">
                        Propuesta Técnico-Comercial
                    </span>
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-white">
                        Sistema Fotovoltaico On-Grid 4,64 kWp — Inyección Cero
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-slate-700/80">
                    <div class="bg-slate-800/60 backdrop-blur border border-slate-700/50 p-3.5 rounded-xl">
                        <span class="text-xs text-slate-400 font-medium block">Cliente</span>
                        <strong class="text-sm font-semibold text-slate-100 block mt-0.5">Campero Octavio Francisco Leandro</strong>
                    </div>
                    <div class="bg-slate-800/60 backdrop-blur border border-slate-700/50 p-3.5 rounded-xl">
                        <span class="text-xs text-slate-400 font-medium block">Ubicación</span>
                        <strong class="text-sm font-semibold text-slate-100 block mt-0.5">Leandro N. Alem 461, La Banda, Santiago del Estero</strong>
                    </div>
                    <div class="bg-slate-800/60 backdrop-blur border border-slate-700/50 p-3.5 rounded-xl">
                        <span class="text-xs text-slate-400 font-medium block">Objetivo Principal</span>
                        <strong class="text-sm font-semibold text-amber-400 block mt-0.5">Autoconsumo & Reducción de Factura</strong>
                    </div>
                </div>
            </div>
        </section>

        <!-- EXECUTIVE KPI CARDS -->
        <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm text-center">
                <i class="fa-solid fa-solar-panel text-amber-500 text-xl mb-2"></i>
                <p class="text-xs font-medium text-slate-500 uppercase">Potencia Instalada</p>
                <p class="text-xl sm:text-2xl font-bold text-slate-900 mt-1">4,64 <span class="text-sm font-semibold text-slate-500">kWp</span></p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm text-center">
                <i class="fa-solid fa-bolt text-emerald-500 text-xl mb-2"></i>
                <p class="text-xs font-medium text-slate-500 uppercase">Generación Anual</p>
                <p class="text-xl sm:text-2xl font-bold text-slate-900 mt-1">≈ 7.450 <span class="text-sm font-semibold text-slate-500">kWh</span></p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm text-center">
                <i class="fa-solid fa-hand-holding-dollar text-blue-500 text-xl mb-2"></i>
                <p class="text-xs font-medium text-slate-500 uppercase">Inversión Llave en Mano</p>
                <p class="text-xl sm:text-2xl font-bold text-slate-900 mt-1">USD 3.961,24</p>
                <span class="text-[10px] text-slate-400 font-medium">≈ $6.100.310 ARS</span>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm text-center">
                <i class="fa-solid fa-chart-line text-indigo-500 text-xl mb-2"></i>
                <p class="text-xs font-medium text-slate-500 uppercase">Retorno Estimado</p>
                <p class="text-xl sm:text-2xl font-bold text-indigo-600 mt-1">≈ 5,8 <span class="text-sm font-semibold text-slate-500">Años</span></p>
            </div>
        </section>

        <!-- SPECIAL VISUAL FEATURE: ¿CÓMO FUNCIONA LA PRODUCCIÓN SOLAR Y EL COSTO VARIABLE? -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-8 space-y-6">
            <div class="border-b border-slate-200 pb-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                    <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2 h-6 bg-amber-500 rounded-full inline-block"></span>
                        ¿Cómo Funciona la Producción Solar y el Ahorro en el Costo Variable?
                    </h3>
                    <span class="px-3 py-1 bg-amber-50 text-amber-800 text-xs font-bold rounded-lg border border-amber-200 self-start md:self-auto">
                        <i class="fa-solid fa-lightbulb text-amber-500 mr-1"></i> Análisis Energético Explicativo
                    </span>
                </div>
            </div>

            <!-- Conceptual Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 bg-amber-50/70 border border-amber-200 rounded-xl space-y-2">
                    <h4 class="text-sm font-bold text-amber-900 flex items-center gap-2">
                        <i class="fa-solid fa-sun text-amber-600"></i> Curva de Generación Solar Diurna
                    </h4>
                    <p class="text-xs text-amber-950 leading-relaxed">
                        Los paneles fotovoltaicos generan electricidad proporcionalmente a la radiación solar disponible, comenzando al amanecer, alcanzando su <strong>pico máximo de generación entre las 10:00 y las 16:00 hs</strong> y decayendo hacia el atardecer.
                    </p>
                </div>

                <div class="p-4 bg-emerald-50/70 border border-emerald-200 rounded-xl space-y-2">
                    <h4 class="text-sm font-bold text-emerald-900 flex items-center gap-2">
                        <i class="fa-solid fa-receipt text-emerald-600"></i> Reducción Directa del Costo Variable
                    </h4>
                    <p class="text-xs text-emerald-950 leading-relaxed">
                        La factura de <strong>EDESE S.A.</strong> posee un término de consumo por kWh (Costo Variable). Cada kWh generado por el sistema solar que se consume instantáneamente en el inmueble <strong>deja de comprarse a la red</strong>, eliminando directamente dicho cargo variable.
                    </p>
                </div>
            </div>

            <!-- 24-HOUR HOURLY PROFILE CHART -->
            <div class="bg-slate-50 p-4 sm:p-6 rounded-2xl border border-slate-200 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <div>
                        <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider">
                            Perfil Horario Típico de 24 Horas: Generación Solar vs. Consumo
                        </h4>
                        <p class="text-xs text-slate-500">
                            Visualización de la cobertura solar sobre el consumo instantáneo durante un día estándar de operación.
                        </p>
                    </div>
                    <div class="flex items-center gap-3 text-[11px] font-semibold text-slate-600 flex-wrap">
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span> Generación Solar</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-slate-400 inline-block"></span> Consumo Total</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Autoconsumo (Ahorro Variable)</span>
                    </div>
                </div>

                <div class="h-72 sm:h-80 relative w-full">
                    <canvas id="chartPerfilDiario"></canvas>
                </div>

                <!-- Callouts under chart -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-2">
                    <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-xs">
                        <span class="font-bold text-slate-800 block mb-0.5"><i class="fa-solid fa-arrow-down-long text-emerald-500"></i> Zona de Autoconsumo (Verde)</span>
                        <p class="text-slate-600 text-[11px]">Energía consumida directamente del sol. Es la energía que reduce un 100% el término variable de la factura.</p>
                    </div>
                    <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-xs">
                        <span class="font-bold text-slate-800 block mb-0.5"><i class="fa-solid fa-plug text-slate-500"></i> Importación de Red (Gris)</span>
                        <p class="text-slate-600 text-[11px]">Energía consumida fuera de las horas de sol o excedente nocturno que se continúa comprando a EDESE S.A.</p>
                    </div>
                    <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-xs">
                        <span class="font-bold text-slate-800 block mb-0.5"><i class="fa-solid fa-shield-halved text-amber-500"></i> Control Smart Meter</span>
                        <p class="text-slate-600 text-[11px]">Modula el inversor en tiempo real para evitar cualquier inyección a la red pública (Inyección Cero).</p>
                    </div>
                </div>
            </div>

            <!-- Cargos Fijos vs Variables Box -->
            <div class="p-4 bg-slate-800 text-slate-200 rounded-xl text-xs space-y-2">
                <strong class="font-bold text-amber-400 flex items-center gap-1.5 text-sm">
                    <i class="fa-solid fa-circle-exclamation"></i> Precisiones sobre la Factura de Energía (Cargos Fijos vs. Variables)
                </strong>
                <p class="text-slate-300 leading-relaxed">
                    El ahorro generado por el sistema solar actúa sobre el <strong>costo variable proporcional de los kWh consumidos</strong>. No elimina los cargos fijos de la factura (como cargo fijo de servicio comercial, potencia contratada básica o impuestos fijos del medidor), garantizando así una expectativa financiera realista y sin sorpresas.
                </p>
            </div>
        </section>

        <!-- SECTION 1 & 2: PROPUESTA Y SISTEMA PROPUESTO -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-8 space-y-6">
            <div class="border-b border-slate-200 pb-4">
                <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2 h-6 bg-amber-500 rounded-full inline-block"></span>
                    1. Propuesta y Objetivo del Proyecto
                </h3>
            </div>

            <p class="text-sm text-slate-600 leading-relaxed">
                IntiWatt propone la instalación de un sistema fotovoltaico On-Grid de <strong>4,64 kWp</strong>, diseñado específicamente para reducir la cantidad de energía eléctrica que el inmueble necesita comprar a la red de <strong>EDESE S.A.</strong>
            </p>
            <p class="text-sm text-slate-600 leading-relaxed">
                El sistema será configurado para <strong>inyección cero</strong>, priorizando el autoconsumo de la energía generada. El objetivo técnico y económico no es simplemente producir la mayor cantidad posible de energía, sino <strong>reducir de manera efectiva y sostenida el costo de electricidad del inmueble</strong>.
            </p>

            <div class="pt-2">
                <h4 class="text-sm font-bold text-slate-800 mb-3 uppercase tracking-wider">
                    2. Especificaciones Técnicas del Sistema Propuesto
                </h4>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs sm:text-sm border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
                                <th class="p-3 rounded-l-xl">Característica</th>
                                <th class="p-3 rounded-r-xl">Especificación Técnica</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Potencia Fotovoltaica</td>
                                <td class="p-3 font-bold text-slate-900">4,64 kWp</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Módulos Solares</td>
                                <td class="p-3 text-slate-800">8 × 580 Wp</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Tecnología Módulos</td>
                                <td class="p-3 text-slate-800"><span class="px-2 py-0.5 bg-amber-100 text-amber-800 rounded font-semibold text-xs">TOPCon N-Type</span> (Alta eficiencia)</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Inversor Central</td>
                                <td class="p-3 font-bold text-slate-900">GoodWe 5 kW</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Medición y Control</td>
                                <td class="p-3 text-slate-800">Smart Meter GoodWe (Gestión Dinámica)</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Configuración</td>
                                <td class="p-3 text-slate-800">On-Grid (Conectado a Red)</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Inyección a Red</td>
                                <td class="p-3 font-bold text-amber-600">Cero (0%)</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-medium text-slate-700">Destino de la Energía</td>
                                <td class="p-3 font-bold text-emerald-700">Autoconsumo Inmueble</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

