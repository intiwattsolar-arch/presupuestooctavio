                        <line x1="106" y1="105" x2="106" y2="113" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="117" y1="105" x2="117" y2="113" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="67" y1="63" x2="75" y2="63" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="67" y1="74" x2="75" y2="74" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="67" y1="86" x2="75" y2="86" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="67" y1="97" x2="75" y2="97" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="125" y1="63" x2="133" y2="63" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="125" y1="74" x2="133" y2="74" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="125" y1="86" x2="133" y2="86" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="125" y1="97" x2="133" y2="97" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <circle cx="100" cy="80" r="54" stroke="#F59E0B" stroke-width="4.5" fill="none"/>
                        <path d="M100 26 L100 14" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <circle cx="100" cy="10" r="4.5" fill="#F59E0B"/>
                        <path d="M100 134 L100 146" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <circle cx="100" cy="150" r="4.5" fill="#F59E0B"/>
                        <path d="M46 80 L34 80" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <circle cx="30" cy="80" r="4.5" fill="#F59E0B"/>
                        <path d="M154 80 L166 80" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <circle cx="170" cy="80" r="4.5" fill="#F59E0B"/>
                        <path d="M121 30 L130 18" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
                        <circle cx="133" cy="14" r="4.5" fill="#F59E0B"/>
                        <path d="M138 42 L150 32 L158 32" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="163" cy="32" r="4.5" fill="#F59E0B"/>
                        <path d="M149 59 L162 52 L172 52" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="177" cy="52" r="4.5" fill="#F59E0B"/>
                        <path d="M149 101 L162 108 L172 108" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="177" cy="108" r="4.5" fill="#F59E0B"/>
                        <path d="M138 118 L150 128 L158 128" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="163" cy="128" r="4.5" fill="#F59E0B"/>
